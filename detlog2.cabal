cabal-version:      2.4
name:               detlog2
version:            0.1.0
synopsis:           A choicepointless, cutless Prolog interpreter and Detlog converter
license:            BSD-3-Clause
author:             Lucian Green
build-type:         Simple
extra-source-files: README.md

library
    exposed-modules:  Detlog2.Term Detlog2.Parser Detlog2.Pretty Detlog2.Builtins
                      Detlog2.Prelude Detlog2.Interp Detlog2.Reference Detlog2.CutElim
                      Detlog2.Convert Detlog2.Check Detlog2.Memo Detlog2.Mnns Detlog2.Equiv
    hs-source-dirs:   src
    build-depends:    base >=4.14 && <5, containers, process, directory
    default-language: Haskell2010

executable detlog2
    main-is:          Main.hs
    hs-source-dirs:   app
    build-depends:    base >=4.14 && <5, containers, process, directory, detlog2
    default-language: Haskell2010
